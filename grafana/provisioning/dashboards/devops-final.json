{
  "uid": "devops-final",
  "title": "DevOps Final",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы в секунду по маршрутам",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (route, status) (rate(http_requests_total[1m]))", "legendFormat": "{{route}} {{status}}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Всего запросов",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(http_requests_total)" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Цель app",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"app\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Память процесса, МБ",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes{job=\"app\"} / 1024 / 1024", "legendFormat": "rss" }]
    }
  ]
}
